# Правила для R8 — того, что выкидывает из выпуска неиспользуемое и
# переименовывает остальное.
#
# До 2.6 сжатия не было вовсе: `isMinifyEnabled = false`, и в сборку целиком
# уезжал набор material-icons-extended — тысячи значков ради ста тридцати
# восьми. Тридцать мегабайт байткода из сорока семи были им.
#
# Включённый R8 — самый опасный шаг из всей уборки, и опасен он не тем, что
# что-то не соберётся, а тем, что соберётся и сломается на телефоне. Ломается
# всегда одно и то же: код, к которому обращаются **по имени**, — а имени после
# переименования нет. Ниже перечислено всё такое в Askya, и у каждого правила
# написано, что именно оно спасает.


# ─────────────────────────── libVLC ───────────────────────────
#
# Плеер AskyaV. Половина его — нативная библиотека на C, и она зовёт Java-код
# обратно через JNI: ищет класс по строке «org/videolan/libvlc/MediaPlayer»,
# метод по строке «dispatchEventFromNative». Переименованный класс она не
# найдёт и не скажет об этом ничего внятного — приложение упадёт в тот миг,
# когда человек нажмёт «играть».
#
# Поэтому здесь `{ *; }`, а не выборочные члены: какие именно имена нужны
# нативной стороне, снаружи не видно, а цена ошибки — неработающий раздел.
-keep class org.videolan.** { *; }
-dontwarn org.videolan.**

# Любой метод с телом на C держится за своё имя по той же причине.
-keepclasseswithmembernames class * {
    native <methods>;
}


# ─────────────────────── Перечисления Askya ───────────────────────
#
# Самое тихое из того, что мог сломать R8.
#
# Важность дела, знак, краска-метка, вид счёта, валюта, вид записи, знак строки
# списка — всё это хранится в базе **именем константы**, а не номером
# (`data/db/converter/Converters.kt`, и там же написано почему). Читается оно
# сравнением строк: `entries.firstOrNull { it.name == value }`.
#
# Переименуй R8 константу в `a` — и запись, сделанная вчера, откроется с
# важностью по умолчанию, книга потеряет цвет корешка, счёт — валюту. Ничего не
# упадёт, ошибки не будет, в логе — пусто. И то же самое случится с каждым
# старым «Слепком»: он тоже хранит имена.
-keepclassmembers class * extends java.lang.Enum {
    <fields>;
    public static **[] values();
    public static ** valueOf(java.lang.String);
}


# ───────────────────────────── Room ─────────────────────────────
#
# Сама Room к переименованию готова: имена колонок она вписывает в SQL при
# сборке, и обфускация полей их не задевает. Сущности всё же держатся целиком —
# ценой в несколько десятков классов покупается то, что при следующей правке
# схемы не придётся вспоминать, готова ли она.
-keep class app.askya.data.entity.** { *; }
-keep interface app.askya.data.db.dao.** { *; }
-keep class app.askya.data.db.converter.** { *; }


# ────────────────────────── Читаемый след ──────────────────────────
#
# Askya обновляется сама и живёт без краш-репортера: единственный след упавшей
# сборки — то, что человек покажет с экрана. Без этих строк в следе одни буквы
# `a.b.c`, и по нему не найти ничего.
#
# Карта переименований остаётся в `app/build/outputs/mapping/release/`.
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile
