<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Сеть — ради одной погоды и больше ни ради чего.

        Прежде разрешения не было вовсе, и это было заявлено принципом: всё —
        заметки, расписание, списки, музыка, книги — живёт на телефоне. Так
        оно и осталось: ни одна запись никуда не уходит, аккаунтов нет, облака
        нет, аналитики нет.

        Погода — единственное, чего на телефоне взять неоткуда: её надо
        спросить. Спрашивается она у Open-Meteo — без ключа и без аккаунта, —
        и в запросе едут ровно две вещи: широта и долгота, округлённые до
        километра (`weather/WeatherService.kt`). Выключенная в настройках
        погода возвращает приложение к прежнему состоянию: в сеть оно не
        выходит ни разу.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Где телефон — для погоды. Грубое место, а не точное: погоду спрашивают
        на город, и знать дом человека приложению незачем. Спрашивается при
        входе в раздел погоды, как и всё остальное в Askya.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Уведомления напоминаний. С Android 13 их спрашивают у человека. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Будильник, который звонит в названную минуту.

        Прежде напоминания ставились неточным будильником — нарочно, чтобы не
        просить лишнего. Оказалось, что просить было надо: неточный будильник в
        дремоте ждёт, пока телефон проснётся сам, а лежащий экраном вниз
        телефон не просыпается по четверти часа. «Напомни в 19:00» звонило в
        19:09, и это уже не напоминание.

        Два разрешения, а не одно, потому что Android поменял правила посреди
        дороги. USE_EXACT_ALARM (Android 13 и новее) система выдаёт сама при
        установке, и выпрашивать его не приходится — оно для того и заведено,
        чтобы будильникам и напоминаниям не пришлось. На версиях старше его не
        существует, и там работает SCHEDULE_EXACT_ALARM: оно тоже выдаётся по
        умолчанию, но человек может снять его в настройках телефона. Тогда
        Askya не падает в неточный будильник втихую — экран напоминаний
        говорит, что случилось, и ведёт туда, где переключатель
        (`reminders/ReminderAlarms.kt`).

        maxSdkVersion у второго — не осторожность, а точность: на новых Android
        его роль занята первым, и объявлять оба значило бы просить одно и то же
        дважды.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!--
        Музыка для AskyaEcho. С Android 13 у аудио своё разрешение; на
        версиях до неё общее чтение хранилища, ограниченное maxSdkVersion:
        на новых система его всё равно не даёт, а в списке разрешений оно
        выглядело бы как запрос на все файлы подряд.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!--
        Видео для AskyaV. С Android 13 у него своё разрешение, отдельное от
        музыки: раздел с фильмами не должен получать доступ к музыке заодно, и
        наоборот. На версиях до неё хватает общего чтения хранилища, объявленного
        выше.

        Разрешение спрашивается при входе в раздел, а не на первом запуске.
        Отдельный файл, открытый через системный выбор, играет и без него: там
        доступ приходит вместе с самим файлом.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        Удаление песни с телефона. С Android 10 файл стирается через системное
        окно подтверждения, и права на запись для этого не нужно; до неё другого
        способа нет — отсюда maxSdkVersion. Спрашивается оно не заранее, а в
        момент, когда человек просит удалить.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
        Библиотека Askya — своя папка в корне памяти
        (`data/library/AskyaLibrary.kt`). Заведена по прямой просьбе и по
        внятной причине: у приложения должно быть одно место, куда оно кладёт
        копии, чтобы уборка галереи не уносила с собой приложенное к записям.

        С Android 11 создать папку в корне иначе нельзя: обычные разрешения
        пускают только в общие разделы («Pictures», «Movies») и в свою папку
        приложения, куда проводник с той же версии не заходит. Отсюда
        MANAGE_EXTERNAL_STORAGE — разрешение широкое, и потому:

        — оно не спрашивается на первом запуске и вообще нигде, кроме строки
          «Библиотека Askya» в настройках, где рядом сказано, зачем оно;
        — отказ ничего не ломает: библиотека объявляет себя неготовой, и всё,
          что писалось в «Pictures/Askya» и «Movies/Askya», пишется туда же;
        — читать чужие файлы этим правом приложение не начинает: наружу из
          Askya по-прежнему уходит один запрос погоды.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
        Обновление из облака (`app/update/`). Askya не лежит в магазине
        приложений, и до сих пор новая сборка приезжала файлом на рабочий стол.
        Теперь приложение умеет спросить у GitHub, нет ли сборки новее, скачать
        её и отдать системному установщику — окно установки показывает система,
        и «да» в нём говорит человек, а не приложение.

        Разрешение только на запрос установки; поставить что-либо молча оно не
        даёт и дать не может.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Плеер в шторке и в системном центре управления. Звук идёт и когда
        приложение свёрнуто, а служба переднего плана — единственный способ
        сказать системе, что процесс убивать посреди песни нельзя. Тип
        mediaPlayback с Android 14 обязателен и объявляется дважды: правом и
        самой службой.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
        Виджет расписания переживает перезагрузку, а будильники — нет. Без
        этого разрешения он замирал бы на том, что показывал до выключения
        телефона, пока система не разбудит его сама.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Надиктовка заметок. Микрофон слушает сама Askya, а распознаёт речь
        системная служба: своё окно распознавания показывает чужое приложение
        во весь экран, и заметка на это время пропадает из виду.

        Это единственное место, где телефон может выйти в интернет — на части
        устройств распознавание работает только с сетью; на этом оно есть
        отдельным приложением и работает без неё. Разрешение спрашивается не на
        входе в заметку, а по нажатию значка микрофона: до него надиктовка не
        нужна, а спрошенное заранее выглядит как подслушивание.

        Без queries Android 11+ не даст даже увидеть, есть ли распознавание на
        телефоне.

        Тем же разрешением пишется голосовая заметка в Scroll — «Голос». Там
        звук не уходит никуда вовсе: он ложится файлом в папку Askya и играется
        оттуда. И там оно тоже спрашивается по нажатию кнопки, а не на входе; в
        фоне микрофон не держится ни секунды — службы у диктофона нет, и уход с
        экрана запись заканчивает.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Дрожь — у напоминания: канал уведомлений заведён с ней
        (`reminders/ReminderAlarms.kt`), а разрешение на неё система требует
        даже тогда, когда трясёт не приложение, а само уведомление.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>

        <!--
            Мосты: чтобы человек мог выбрать, чем он читает и чем созванивается.

            С Android 11 приложение не видит, что ещё стоит на телефоне, пока не
            скажет, что именно ищет. Здесь спрашивается ровно то, что показывает
            рабочий стол: приложения с обычным входом (MAIN/LAUNCHER). Ни одного
            имени пакета в этом списке нет и быть не может — Askya не знает, чем
            человек читает, и выбирает он сам (см. `data/entity/Bridge.kt`).

            Без этой строки список выбора пуст, и мосты не к чему подключать.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
        По http приложение не ходит вовсе — что и почему, написано в
        `xml/network_security_config.xml`. Прежде здесь стояло
        usesCleartextTraffic="true" ради скачивания видео по ссылке, и снимало
        оно запрет заодно с погоды и проверки обновлений.

        Отдельным файлом, а не строкой в манифесте: запрет — это решение, и у
        него должно быть место, где его объясняют.
    -->

    <!--
        Резервная копия Google выключена.

        Прежде она была включена, с описанными исключениями, и держалась на
        одном доводе: своей выгрузки у Askya нет, а телефон бьётся. Довод
        кончился вместе со «Слепком» — человек делает его руками и кладёт туда,
        куда сам решил.

        А цена осталась. В копию уезжает база целиком: Ledger, «Прожитое»,
        записи Scroll, расписание за годы. Это чужой диск, привязанный к
        аккаунту Google, и включённым он был не выбором, а значением по
        умолчанию.

        Вместе с копией убраны и правила к ней: списки исключений без копии не
        значат ничего.
    -->
    <application
        android:name=".app.AskyaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:requestLegacyExternalStorage="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Askya">

        <!--
            configChanges — ради плеера AskyaV. Без него поворот телефона
            пересоздаёт Activity, и фильм на секунду гаснет вместе с ней.
            Compose переживает смену настроек сам: он читает их из composition
            local, который обновляется и без пересоздания.
        -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Askya в системном «Открыть с помощью».

                Объявлено ровно то, что она показывает своими силами: музыка,
                книги, документы, картинки, видео. Ни `*/*`, ни «на всякий
                случай»: приложение, которое предлагает себя для всякого файла,
                человек учится пролистывать, и в тот раз, когда оно
                действительно нужно, он его уже не читает.

                Разбор того, что пришло, — в одном месте
                (`app/FileOpenRouter.kt`), и оно же решает, в какой раздел файл
                отдать.

                ## Первый фильтр — по типу, и это главный

                Прежде первым стоял фильтр по расширению **в самой ссылке**
                (`pathPattern`), и работал он, пока файл приходил из проводника:
                там в ссылке есть путь, а в пути имя. Из «Загрузок», из Drive,
                из мессенджера приходит `content://…/document/1247` — имени в
                ней нет вовсе, фильтр не срабатывает, и Askya просто не
                появляется в списке. Молча: человек видит, что его приложения
                там нет, и не может знать почему.

                Тип провайдеры отдают почти всегда, и потому он первый.
            -->
            <intent-filter android:label="Открыть в Askya">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/csv" />

                <!-- Списки песен: система зовёт их то так, то этак. -->
                <data android:mimeType="audio/x-mpegurl" />
                <data android:mimeType="audio/mpegurl" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
            </intent-filter>

            <!--
                Второй фильтр — для того, у чего типа нет.

                `application/octet-stream` провайдеры отдают за всё, чего не
                узнали: за mkv, за flac, за fb2. Такой файл ловится по концу
                имени — `pathSuffix`, а не прежний `pathPattern` с обязательной
                звёздочкой впереди: то же самое, но без строки, в которой можно
                ошибиться.

                Оговорка честная: `pathSuffix` появился в Android 12. На
                версиях старше система его не понимает и пропускает — а фильтр
                без единого ограничения по пути начинает подходить ко всякому
                `octet-stream`. Askya пишется под телефон, который у человека в
                руках, и он новее; знать об этом всё же стоит.
            -->
            <intent-filter android:label="Открыть в Askya">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />

                <data android:pathSuffix=".fb2" />
                <data android:pathSuffix=".mp3" />
                <data android:pathSuffix=".m4a" />
                <data android:pathSuffix=".m4b" />
                <data android:pathSuffix=".flac" />
                <data android:pathSuffix=".wav" />
                <data android:pathSuffix=".ogg" />
                <data android:pathSuffix=".oga" />
                <data android:pathSuffix=".opus" />
                <data android:pathSuffix=".aac" />
                <data android:pathSuffix=".wma" />
                <data android:pathSuffix=".ape" />
                <data android:pathSuffix=".mka" />
                <data android:pathSuffix=".m3u" />
                <data android:pathSuffix=".m3u8" />
                <data android:pathSuffix=".cue" />
                <data android:pathSuffix=".mkv" />
                <data android:pathSuffix=".avi" />
                <data android:pathSuffix=".mp4" />
                <data android:pathSuffix=".m4v" />
                <data android:pathSuffix=".mov" />
                <data android:pathSuffix=".webm" />
                <data android:pathSuffix=".ts" />
                <data android:pathSuffix=".m2ts" />
                <data android:pathSuffix=".flv" />
                <data android:pathSuffix=".wmv" />
                <data android:pathSuffix=".mpg" />
                <data android:pathSuffix=".mpeg" />
                <data android:pathSuffix=".3gp" />
                <data android:pathSuffix=".ogv" />
                <data android:pathSuffix=".rmvb" />
                <data android:pathSuffix=".vob" />
                <data android:pathSuffix=".divx" />
                <data android:pathSuffix=".asf" />
            </intent-filter>

            <!--
                Третий — запасной, и только для `file://`.

                Такие ссылки приходят от старых приложений: между приложениями
                Android их давно не пропускает. Здесь остался `pathPattern` —
                на этих версиях он и работал, — и потому каждое расширение
                стоит дважды: регистр в нём значим, а файлы, скачанные с разных
                сайтов, приходят и так, и так.
            -->
            <intent-filter android:label="Открыть в Askya">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="file" />
                <data android:host="*" />

                <data android:pathPattern=".*\.fb2" />
                <data android:pathPattern=".*\.FB2" />
                <data android:pathPattern=".*\.mp3" />
                <data android:pathPattern=".*\.MP3" />
                <data android:pathPattern=".*\.m4a" />
                <data android:pathPattern=".*\.M4A" />
                <data android:pathPattern=".*\.m4b" />
                <data android:pathPattern=".*\.M4B" />
                <data android:pathPattern=".*\.flac" />
                <data android:pathPattern=".*\.FLAC" />
                <data android:pathPattern=".*\.wav" />
                <data android:pathPattern=".*\.WAV" />
                <data android:pathPattern=".*\.ogg" />
                <data android:pathPattern=".*\.OGG" />
