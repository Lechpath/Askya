<?xml version="1.0" encoding="utf-8"?>
<!--
    По http Askya не ходит.

    Прежде в манифесте стояло `usesCleartextTraffic="true"` — одной строкой на
    всё приложение, — и ставилось оно ради «Скачать по ссылке» в AskyaV: часть
    роликов до сих пор лежит на серверах без https. Плата за это была не по
    товару: разрешение снимало запрет со всего, что приложение делает в сети,
    включая погоду и проверку обновлений, и незашифрованный ответ по дороге
    домой перестал бы отличаться от подменённого.

    Теперь запрет общий и без исключений. Список доменов здесь не заведён
    намеренно: доменов, к которым Askya обращается сама, всего три — погода,
    её геокодер и GitHub, — и все три отвечают по https; а тот адрес, который
    человек набирает руками в окне ссылки, заранее не назовёшь, и «явный
    список» для него — выдумка.

    ## Что от этого изменилось, а что нет

    **Смотреть по ссылке — по-прежнему работает, и по http тоже.** Поток
    открывает не Askya, а сам VLC своими средствами, минуя сетевой слой
    Android: этот запрет до него не достаёт. Потоки с камер и записи с домашних
    серверов играются как играли.

    **Скачать по ссылке — только по https.** Вот это качает уже приложение, и
    вот здесь запрет действует: http-адрес в окне скачивания ответит отказом.
    Такова цена, и названа она честно.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
