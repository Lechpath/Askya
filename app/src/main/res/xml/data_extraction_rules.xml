<?xml version="1.0" encoding="utf-8"?>
<!--
    Что уезжает в резервную копию, а что нет. Android 12 и новее; до неё то же
    самое сказано в `backup_rules.xml`, и списки исключений в двух файлах должны
    совпадать.

    Копия здесь не выключена целиком, и намеренно: своей выгрузки у Askya пока
    нет, а телефон бьётся. Системная копия — единственное, что стоит между
    человеком и записями за годы, и до тех пор, пока «Слепок» не сделан, отнимать
    её было бы честностью в ущерб человеку.

    Но копия — это чужой диск, и потому наружу не едет то, что либо ничего не
    стоит восстанавливать, либо рассказывает о человеке больше, чем нужно для
    восстановления записей.

    `cloud-backup` — копия в Google, `device-transfer` — переезд на новый телефон
    с провода на провод. Второе не уходит наружу вовсе, и место телефона там
    исключать незачем: оно приедет туда же, где и лежало. А вот кэш погоды не
    нужен и там — он протухнет по дороге.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
            Погода: выбранные города с координатами и последние ответы сервера.
            Координаты — это место, где человек живёт; в чужой копии ему не место,
            а стоит оно одного выбора города руками. Ответы сервера протухают за
            час и в копии бессмысленны.
        -->
        <exclude domain="file" path="datastore/weather.preferences_pb" />

        <!--
            Старые копии картинок и видео в `Android/data`. Люди, читавшие
            иллюстрированные книги и снимавшие ролики, держат там сотни мегабайт,
            а копия режется на двадцати пяти: положив туда видео, приложение не
            сохранило бы ничего вовсе. Нынешние картинки лежат в `Pictures/Askya`
            и в копию приложения не входят по-другому — это общая память телефона.
        -->
        <exclude domain="external" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
