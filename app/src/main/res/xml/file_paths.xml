<?xml version="1.0" encoding="utf-8"?>
<!--
    Что Askya готова отдать наружу по ссылке.

    Отправить файл чужому приложению можно только так: `file://` с Android 7
    вылетает исключением, а прав на нашу папку у мессенджера нет. Провайдер
    выдаёт ссылку на один файл и только тому, кого выбрали в окне «поделиться».

    `share` — кэш под отправляемое из правки: наружу уходит то, что на экране,
    вместе с несохранёнными правками, и складывать это в папку Askya незачем.
    `updates` — тем же кэшем скачанная сборка: системному установщику её
    отдают ссылкой, и без этой строки окно установки не открылось бы.
    `askya` — библиотека в корне памяти: из неё делятся тем, что в ней лежит.
    Последние два — прежняя папка приложения, где лежат картинки, добавленные
    до переезда в Pictures/Askya, и все копии на Android 9 и старше.
-->
<paths>
    <cache-path name="share" path="share/" />
    <cache-path name="updates" path="updates/" />
    <external-path name="askya" path="Askya/" />
    <external-files-path name="images" path="Images/" />
    <files-path name="images" path="Images/" />
</paths>
