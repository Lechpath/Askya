<?xml version="1.0" encoding="utf-8"?>
<!--
    Знак Threads — нить с иглой на конце: линия, которая тянется через
    полотно, ныряет и выходит снова.

    Не узел и не клубок: клубок в очерке становится спиралью, неотличимой на
    24 dp от значка загрузки, а узел читается как «запуталось» — обратное
    тому, о чём раздел. Нить именно тянут, и тянут в одну сторону.

    Ушко иглы — короткий овал у верхнего конца: без него игла выглядит гвоздём.
    Обводкой, одной толщины с остальными знаками меню.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Сама нить: волна слева направо, к игле -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,17.5 C6,17.5 6.5,11 9.5,11 C12.5,11 13,17.5 16,17.5" />

    <!-- Игла: от нити вверх направо -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M16,17.5 L20.6,5.6" />

    <!-- Ушко -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M19.2,9.2 A1.15,1.15 0 0 1 20.9,10.1" />

</vector>
