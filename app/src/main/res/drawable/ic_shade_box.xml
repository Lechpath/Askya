        android:pathData="M4,1.5 L16,1.5 A2.5,2.5 0 0 1 18.5,4 L18.5,16 A2.5,2.5 0 0 1 16,18.5 L4,18.5 A2.5,2.5 0 0 1 1.5,16 L1.5,4 A2.5,2.5 0 0 1 4,1.5 Z"
        android:strokeColor="#FF9A9A9A"
        android:strokeWidth="1.6"
        android:fillColor="#00000000" />
