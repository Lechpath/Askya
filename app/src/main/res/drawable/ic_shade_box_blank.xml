<?xml version="1.0" encoding="utf-8"?>
<!--
    Пустое место вместо знака — у заголовка раздела в списке дела.

    Заголовок не отмечают, и квадрат перед ним обещал бы отметку, которой нет.
    Прозрачная картинка того же размера, а не спрятанный вид: строка в шторке
    рисуется через RemoteViews, и место под знаком должно остаться занятым —
    иначе текст заголовка уехал бы левее строк, которые он озаглавливает.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="20"
    android:viewportHeight="20">
    <path
        android:pathData="M0,0 L20,0 L20,20 L0,20 Z"
        android:fillColor="#00000000" />
</vector>
