<?xml version="1.0" encoding="utf-8"?>
<!--
    Цветок Askya без надписи. Нужен там, где знак показывается мелко: на
    иконке слово вдоль лепестка читается, а в анимации ожидания оно
    превратилось бы в грязь.

    Лепестков пять и они одинаковые, поэтому поворот ровно на 72 градуса
    возвращает рисунок в себя — на этом держится анимация дыхания.

    Лепестки завёрнуты в именованную группу «breath»: за неё цветок берёт
    системная заставка (ic_flower_breathing.xml) — дышать на ней может только
    сам вектор, Compose там ещё не запущен. Своих преобразований у группы нет,
    и всем остальным она ничего не меняет.

    Файл генерируется: tools\make-icon.ps1.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="breath"
        android:pivotX="54"
        android:pivotY="54">

    <group
        android:pivotX="54"
        android:pivotY="54"
