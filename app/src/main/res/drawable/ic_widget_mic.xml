<?xml version="1.0" encoding="utf-8"?>
<!--
    Микрофон для кнопки виджета — заливкой, а не обводкой.

    Знак раздела «Голос» (ic_scroll_voice) набран обводкой в 1.7 и стоит в
    списке подразделов, где все знаки такие. Здесь он лёг бы на коралловый
    кружок сорока точек шириной, и обводка в этом размере на цветном поле
    рассыпается: заливка держится.

    Волны по бокам тоже нет: там она говорила «здесь лежит звучащее», а тут
    кнопка значит «записать», и капсула с ножкой — ровно это.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <path
        android:fillColor="#FF000000"
        android:pathData="M12,3 A3,3 0 0 1 15,6 V11.5 A3,3 0 0 1 9,11.5 V6 A3,3 0 0 1 12,3 Z" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M6.5,11 A5.5,5.5 0 0 0 17.5,11" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,16.5 V20.5" />

</vector>
