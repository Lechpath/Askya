<?xml version="1.0" encoding="utf-8"?>
<!--
    Знак раздела Scroll — свиток: два валика и полотно между ними.

    Раздел называется Scroll, и лист с загнутым углом из набора Material про
    это ничего не говорил. Валики нарисованы дугами, а не кругами: круг на
    двадцати четырёх точках читается как колесо.

    Обводкой, а не заливкой: одной толщины со знаками подразделов и тонируется
    темой в месте вызова.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Верхний валик. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7,3.2 H17 A2.2,2.2 0 0 1 17,7.6 H7 A2.2,2.2 0 0 1 7,3.2 Z" />

    <!-- Полотно. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M7,7.6 V16.4" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M17,7.6 V16.4" />

    <!-- Строка письма. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M10,12 H14" />

    <!-- Нижний валик. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7,16.4 H17 A2.2,2.2 0 0 1 17,20.8 H7 A2.2,2.2 0 0 1 7,16.4 Z" />

</vector>
