        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M3.8,17 H10.4" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M15.6,17 H20.2" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineJoin="round"
        android:pathData="M13,19.2 A2.2,2.2 0 1 1 13,14.8 A2.2,2.2 0 0 1 13,19.2 Z" />

</vector>
