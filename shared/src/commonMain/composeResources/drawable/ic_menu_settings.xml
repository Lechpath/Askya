<?xml version="1.0" encoding="utf-8"?>
<!--
    Знак настроек — три ползунка на рейках, каждый сдвинут по-своему.

    Солнце с лучами, стоявшее здесь раньше, читалось погодой: в шапке того же
    меню погода и живёт, и два солнца на одном экране означали разное. Ползунок
    же и есть то, что человек делает в настройках, — двигает по одному.

    Не шестерня: шестерни в приложении нет больше нигде, а рейка с кружком
    держит ту же линию обводки, что и остальные знаки меню.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Верхняя рейка: ползунок правее середины. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M3.8,7 H12.4" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M17.6,7 H20.2" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineJoin="round"
        android:pathData="M15,9.2 A2.2,2.2 0 1 1 15,4.8 A2.2,2.2 0 0 1 15,9.2 Z" />

    <!-- Средняя: ползунок слева. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M3.8,12 H6.4" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M11.6,12 H20.2" />

    <path
        android:fillColor="#00000000"
