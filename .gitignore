captures/

# Ключ выпуска и пароли к нему. В репозиторий они не попадают никогда:
# репозиторий публичный, а ключом, попавшим в чужие руки, подписывают
# что угодно от имени Askya. Копию держать отдельно от компьютера —
# потерянный ключ означает, что ни один телефон больше не обновится.
keystore.properties
*.jks
*.keystore

# Собранное и выгруженное: выпуски кладутся в GitHub Releases, а не в код.
*.apk
*.aab
*.msi
*.exe
output-metadata.json

# Логи, дампы и временное.
*.log
*.hprof
*.tmp
*.bak
*~

# Файлы редакторов и системы.
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Прочие ключи и переменные окружения.
.env
.env.*
*.p12
*.pem
